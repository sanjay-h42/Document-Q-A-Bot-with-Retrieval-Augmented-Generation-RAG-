# Document Q&A RAG - Environment Configuration
# Copy this file to .env in the backend directory

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Selected Gemini Model (e.g. gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# ChromaDB & Embedding Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_db
COLLECTION_NAME=rag_documents

# Chunking & Retrieval Parameters
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150
DEFAULT_TOP_K=4
SIMILARITY_THRESHOLD=0.30

# File Upload Security Limits
MAX_FILE_SIZE_MB=25

# Agent Parameters
AGENT_MAX_ITERATIONS=3
DEBUG=false
